# Required. For a physical device, use a phone-reachable HTTPS endpoint.
# Quick-tunnel example: https://generated-name.trycloudflare.com/api/v1
# Do not use localhost/127.0.0.1/::1 or commit a personal LAN IP.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_ENV=development
# release-apk pins production public values in the mobile eas.json and disables
# dotenv loading. This local file remains for Metro/development only.

# Google Sign-In Feature Gate & Client Configuration
# Keep disabled by default. Enable locally only after Firebase Android OAuth is configured
# and a valid Web OAuth client ID is available.
EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Firebase native configuration comes from google-services.json (and a future iOS GoogleService-Info.plist).
# Never put server/database/storage credentials in this file.
