# ==============================================================================
# TESTIMONIUM UNIFIED MONOREPO SYSTEM SAFEGUARDS
# ==============================================================================

# Bulky Project Dependencies (Applies recursively to all client/server dirs)
**/node_modules/
**/jspm_packages/
**/dist/
**/.expo/
**/.next/
**/out/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Global Environment Variables & Cloud Infrastructure Keys (CRITICAL SAFETY)
**/.env
**/.env.local
**/.env.development.local
**/.env.production.local
**/.env.*.local
**/.env.*
!testimonium-parishioner-app/.env.example
!testimonium-backend/.env.example

# Prisma Client Database Specific Exclusions (Fixed subfolder tracking)
testimonium-backend/scripts/presentation_seed_manifest.json
testimonium-backend/scripts/presentation_seed_manifest.json
scripts/presentation_seed_manifest.json
!testimonium-backend/prisma/migrations/20260704123959_init_testimonium_relational_schema/migration.sql
!testimonium-backend/prisma/migrations/20260704140000_rename_vicariate_admin_to_diocese_coordinator/migration.sql
!testimonium-backend/prisma/migrations/20260705113749_make_firebase_uid_optional/migration.sql
!testimonium-backend/prisma/migrations/20260707131952_add_patron_saint_and_email_to_parish/migration.sql
!testimonium-backend/prisma/migrations/20260823120000_add_idempotency_keys/migration.sql
!testimonium-backend/prisma/migrations/20260829090000_planned_additions/migration.sql
!testimonium-backend/prisma/migrations/20260901120000_add_email_preference_and_document_email_types/migration.sql
!testimonium-backend/prisma/migrations/20260902120000_add_parish_councils/migration.sql
!testimonium-backend/prisma/migrations/20260904120000_receipt_attempt_versioning/migration.sql
