PORT=5000
NODE_ENV=development

# Supabase PostgreSQL
SUPABASE_DATABASE_URL=
DATABASE_URL=

# Cloudflare R2 S3-Compatible Configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_IDENTITY_BUCKET_NAME=
R2_REGISTRANT_ID_BUCKET_NAME=
# Required acknowledgement after a private, non-public bucket is provisioned and IAM-scoped.
R2_REGISTRANT_ID_BUCKET_APPROVED=false
R2_PUBLIC_URL=

# Relationship-evidence upload and durable worker controls
REGISTRANT_ID_UPLOAD_RATE_LIMIT_MAX=6
REGISTRANT_ID_WORKER_POLL_MS=15000
REGISTRANT_ID_WORKER_BATCH_SIZE=2
REGISTRANT_ID_WORKER_LEASE_SECONDS=90
REGISTRANT_ID_OCR_MAX_ATTEMPTS=3
REGISTRANT_ID_CLEANUP_MAX_ATTEMPTS=8

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Development Options (intended only for local development, never enable in production)
ENABLE_DEV_AUTH=false
ADMIN_EMAIL_VERIFICATION_REQUIRED=false

# Transactional email: gmail_api uses HTTPS (Render Free); smtp is the default when omitted.
EMAIL_TRANSPORT=gmail_api
# Reuse the existing OAuth grant with gmail.send scope. Never commit real credentials.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Sender fields are shared by both transports. Gmail API requires this authorized account.
SMTP_FROM_NAME=TESTIMONIUM
SMTP_FROM_EMAIL=testimonium.system@gmail.com
# Only required for EMAIL_TRANSPORT=smtp; unused by Gmail API.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
EMAIL_WORKER_POLL_MS=10000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_LEASE_SECONDS=120
EMAIL_MAX_ATTEMPTS=5

# Government ID verification rate limit (per authenticated account)
GOVERNMENT_ID_RATE_LIMIT_MAX=6
GOVERNMENT_ID_RATE_LIMIT_WINDOW_MS=600000

# Activity Log Retention and Maintenance (purge only works in development environment)
ENABLE_ACTIVITY_PURGE=false
ACTIVITY_LOG_RETENTION_DAYS=365

# AI / RAG Chatbot Configuration (Additive, English-first V1)
CHATBOT_ENABLED=false
CHATBOT_LOG_RAW_TEXT=false

AI_GENERATION_PROVIDER=gemini
AI_GENERATION_MODEL=gemini-3.8-flash

AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSIONS=768

GEMINI_API_KEY=

CHATBOT_GENERATION_TIMEOUT_MS=45000
CHATBOT_EMBEDDING_TIMEOUT_MS=15000
CHATBOT_MAX_RETRIES=2

CHATBOT_TOP_K=8
CHATBOT_MAX_CONTEXT_CHUNKS=4
CHATBOT_MAX_CONTEXT_TOKENS=3500
CHATBOT_MAX_OUTPUT_TOKENS=700

# Testing placeholder - not calibrated for production retrieval
CHATBOT_MIN_SIMILARITY=0.65

CHATBOT_RATE_LIMIT_MAX=10
CHATBOT_DAILY_LIMIT_MAX=50
CHATBOT_RATE_LIMIT_WINDOW_MS=600000

CHATBOT_WORKER_POLL_MS=15000
CHATBOT_WORKER_BATCH_SIZE=5
CHATBOT_WORKER_LEASE_SECONDS=60
