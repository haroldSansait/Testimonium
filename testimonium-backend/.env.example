PORT=5000
NODE_ENV=development

# Supabase PostgreSQL
SUPABASE_DATABASE_URL=
DATABASE_URL=

# Cloudflare R2 S3-Compatible Configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Development Options (intended only for local development, never enable in production)
ENABLE_DEV_AUTH=false
ADMIN_EMAIL_VERIFICATION_REQUIRED=false

# Transactional email (generic SMTP; leave blank to retain queued outbox rows)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=TESTIMONIUM
SMTP_FROM_EMAIL=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
EMAIL_WORKER_POLL_MS=10000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_LEASE_SECONDS=120
EMAIL_MAX_ATTEMPTS=5

# Activity Log Retention and Maintenance (purge only works in development environment)
ENABLE_ACTIVITY_PURGE=false
ACTIVITY_LOG_RETENTION_DAYS=365
