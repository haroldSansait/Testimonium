  queuedAt          DateTime          @default(now()) @map("queued_at")
  sentAt            DateTime?         @map("sent_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
  @@index([referenceType, referenceId])
  @@map("email_outbox")
}

model IdempotencyKey {
  id           Int      @id @default(autoincrement()) @map("idempotency_id")
  key          String   @db.VarChar(128)
  userId       Int      @map("user_id")
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   Int      @map("resource_id")
  payloadHash  String   @map("payload_hash") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, resourceType])
  @@index([userId, key])
  @@map("idempotency_keys")
}

model GovernmentIdVerification {
  id              Int                            @id @default(autoincrement()) @map("verification_id")
  userId          Int                            @unique @map("user_id")
  status          GovernmentIdVerificationStatus @default(NOT_SUBMITTED)
  frontObjectKey  String?                        @map("front_object_key") @db.VarChar(255)
  backObjectKey   String?                        @map("back_object_key") @db.VarChar(255)
  idType          String?                        @map("id_type") @db.VarChar(50)
  verifiedAt      DateTime?                      @map("verified_at")
  expiresAt       DateTime?                      @map("expires_at")
  rejectionReason GovernmentIdRejectionReason?   @map("rejection_reason")
  lastAttemptAt   DateTime?                      @map("last_attempt_at")
  createdAt       DateTime                       @default(now()) @map("created_at")
  updatedAt       DateTime                       @updatedAt @map("updated_at")
  user            User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([expiresAt])
  @@map("government_id_verifications")
}

enum LegalPolicyType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
}

model LegalPolicy {
  policyType  LegalPolicyType @id @map("policy_type")
  content     String          @db.Text
  revision    Int             @default(1)
  effectiveAt DateTime        @map("effective_at") @db.Timestamptz(6)
  updatedById Int?            @map("updated_by_id")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation("LegalPolicyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("legal_policies")
}
