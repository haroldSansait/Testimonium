generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  PARISHIONER
  SECRETARY
  PRIEST
  DIOCESE_COORDINATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ParishType {
  PARISH
  QUASI_PARISH
  MISSION_STATION
}

enum DocumentType {
  BAPTISMAL_CERTIFICATE
  CONFIRMATION_CERTIFICATE
  MARRIAGE_CERTIFICATE
  FIRST_COMMUNION_CERTIFICATE
  MARRIAGE_BANNS
  PERMIT_TO_MARRY
  STATUS_OF_LIBERTY
}

enum DocumentRequestStatus {
  PENDING
  UNDER_REVIEW
  NEEDS_CORRECTION
  PAYMENT_PENDING
  PAYMENT_UNDER_REVIEW
  PAYMENT_NEEDS_CORRECTION
  PAYMENT_VERIFIED
  PROCESSING
  READY_FOR_SIGNING
  READY_FOR_PICKUP
  COMPLETED
  REJECTED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PROOF_SUBMITTED
  CONFIRMED
}

enum PaymentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ScheduleEventType {
  WEDDING
  BAPTISM
  CONFIRMATION
  PRIVATE_MASS
  MASS_INTENTION
  MARRIAGE_SPECIAL
  WAKE_MASS
  FUNERAL
  ANOINTING_OF_THE_SICK
  FIESTA
  BLESSING
  DELIVERANCE
  THANKSGIVING
  FIRST_COMMUNION
  MASS_OF_HOLY_SPIRIT
  CONFESSION
}

enum ScheduleStatus {
  PENDING
  REQUESTED
  PROPOSED_RESCHEDULE
  WAITING_PARISHIONER_RESPONSE
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

enum AvailabilityType {
  PARISH_CLOSED
  SECRETARY_LEAVE
  PRIEST_LEAVE
  FULLY_BOOKED
}

enum NotificationType {
  PUSH
  IN_APP
  EMAIL
}

enum NotificationReferenceType {
  DOCUMENT_REQUEST
  SCHEDULE_REQUEST
  GENERAL
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ScheduleDateRuleMode {
  INHERIT
  AVAILABLE
  UNAVAILABLE
}

enum EventVisibility {
  PUBLIC
  PARISH_PRIVATE
}

enum ReportScope {
  PARISH
  DIOCESE
}

enum ReportCategory {
  MEETING
  ACTIVITY
  IMPORTANT_EVENT
  OTHER
}

enum EmailOutboxStatus {
  QUEUED
  PROCESSING
  SENT
  RETRY
  FAILED
}

enum EmailType {
  DOCUMENT_READY_FOR_PICKUP
  SCHEDULE_SUBMITTED
  SCHEDULE_PROPOSED_RESCHEDULE
  SCHEDULE_CONFIRMED
  DOCUMENT_SUBMITTED
  DOCUMENT_NEEDS_CORRECTION
  DOCUMENT_PAYMENT_NEEDS_CORRECTION
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RegistrantIdOcrStatus {
  AWAITING_IMAGES
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  UNAVAILABLE
}

enum PrivateObjectCleanupStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum GovernmentIdVerificationStatus {
  NOT_SUBMITTED
  VERIFIED
  REJECTED
}

enum GovernmentIdRejectionReason {
  IMAGE_BLURRY
  FRONT_BACK_INCOMPLETE
  NAME_MISMATCH
  ID_EXPIRED
  UNSUPPORTED_OR_INVALID_DOCUMENT
}

model Role {
  id          Int      @id @default(autoincrement()) @map("role_id")
  roleName    RoleName @unique @map("role_name")
  description String?  @db.Text
  users       User[]

  @@map("roles")
}

model Parish {
  id                      Int                         @id @default(autoincrement()) @map("parish_id")
  parishName              String                      @unique @map("parish_name") @db.VarChar(150)
  slug                    String?                     @unique @db.VarChar(150)
  type                    ParishType
  address                 String?                     @db.Text
  municipalityCity        String                      @map("municipality_city") @db.VarChar(100)
  province                String                      @db.VarChar(100)
  contactNumber           String?                     @map("contact_number") @db.VarChar(20)
  patronSaint             String?                     @map("patron_saint") @db.VarChar(150)
  email                   String?                     @db.VarChar(150)
  latitude                Float?
  longitude               Float?
  feastDay                String?                     @map("feast_day") @db.VarChar(100)
  coverImage              String?                     @map("cover_image") @db.VarChar(255)
  logoImage               String?                     @map("logo_image") @db.VarChar(255)
  mapZoom                 Int?                        @map("map_zoom")
  pinColor                String?                     @map("pin_color") @db.VarChar(20)
  showLabel               Boolean                     @default(true) @map("show_label")
  directoryDescription    String?                     @map("directory_description") @db.Text
  locationUpdatedBy       Int?                        @map("location_updated_by")
  locationUpdatedAt       DateTime?                   @map("location_updated_at")
  gallery                 String[]                    @default([])
  isActive                Boolean                     @default(true) @map("is_active")
  documentSettings        String?                     @map("document_settings") @db.Text
  eventSettings           String?                     @map("event_settings") @db.Text
  officeHours             String?                     @map("office_hours") @db.Text
  paymentQrImage          String?                     @map("payment_qr_image") @db.VarChar(255)
  paymentQrEnabled        Boolean                     @default(false) @map("payment_qr_enabled")
  paymentQrUpdatedAt      DateTime?                   @map("payment_qr_updated_at")
  paymentQrUpdatedBy      Int?                        @map("payment_qr_updated_by")
  availableDocuments      Json?                       @map("available_documents")
  venueCapacity           Int?                        @map("venue_capacity")
  schedulingConfigVersion Int                         @default(1) @map("scheduling_config_version")
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  users                   User[]
  documentRequests        DocumentRequest[]
  schedules               Schedule[]
  availabilities          ParishAvailability[]
  massScheduleTemplates   MassScheduleTemplate[]
  parishEvents            ParishEvent[]
  activityLogs            ActivityLog[]
  weekdayRules            ParishWeekdayRule[]
  serviceWeekdayRules     ParishServiceWeekdayRule[]
  scheduleDateRules       ParishScheduleDateRule[]
  dailyReports            DailyReport[]
  councilConfiguration    ParishCouncilConfiguration?
  knowledgeSources        KnowledgeSource[]           @relation("ParishKnowledgeSources")
  isMotherParish          Boolean                     @default(false) @map("is_mother_parish")

  @@index([type])
  @@index([isActive])
  @@index([municipalityCity])
  @@map("parishes")
}

enum ParishCouncilType {
  PASTORAL
  FINANCE
}

model ParishCouncilConfiguration {
  id                    Int                   @id @default(autoincrement()) @map("config_id")
  parishId              Int                   @unique @map("parish_id")
  financeCouncilEnabled Boolean               @default(false) @map("finance_council_enabled")
  version               Int                   @default(1)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  parish                Parish                @relation(fields: [parishId], references: [id], onDelete: Cascade)
  members               ParishCouncilMember[]

  @@map("parish_council_configurations")
}

model ParishCouncilMember {
  id                     Int                        @id @default(autoincrement()) @map("member_id")
  councilConfigurationId Int                        @map("council_configuration_id")
  councilType            ParishCouncilType          @map("council_type")
  positionTitle          String                     @map("position_title") @db.VarChar(200)
  memberName             String                     @map("member_name") @db.VarChar(200)
  sortOrder              Int                        @map("sort_order")
  photoUrl               String?                    @map("photo_url") @db.VarChar(500)
  photoObjectKey         String?                    @map("photo_object_key") @db.VarChar(255)
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")
  councilConfiguration   ParishCouncilConfiguration @relation(fields: [councilConfigurationId], references: [id], onDelete: Cascade)

  @@index([councilConfigurationId, councilType])
  @@index([councilConfigurationId, sortOrder])
  @@map("parish_council_members")
}

model User {
  id                        Int                       @id @default(autoincrement()) @map("user_id")
  firebaseUid               String?                   @unique @map("firebase_uid") @db.VarChar(128)
  fullName                  String                    @map("full_name") @db.VarChar(150)
  email                     String                    @unique @db.VarChar(150)
  contactNumber             String?                   @map("contact_number") @db.VarChar(20)
  address                   String?                   @db.Text
  roleId                    Int                       @map("role_id")
  parishId                  Int?                      @map("parish_id")
  isAssistant               Boolean                   @default(false) @map("is_assistant")
  isVerified                Boolean                   @default(false) @map("is_verified")
  status                    UserStatus                @default(ACTIVE)
  color                     String?                   @db.VarChar(50)
  termsAcceptedAt           DateTime?                 @map("terms_accepted_at")
  privacyAcceptedAt         DateTime?                 @map("privacy_accepted_at")
  termsVersion              String?                   @map("terms_version") @db.VarChar(20)
  privacyVersion            String?                   @map("privacy_version") @db.VarChar(20)
  lastVerificationResentAt  DateTime?                 @map("last_verification_resent_at")
  verificationResentCount   Int                       @default(0) @map("verification_resent_count")
  emailNotificationsEnabled Boolean                   @default(true) @map("email_notifications_enabled")
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")
  role                      Role                      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  parish                    Parish?                   @relation(fields: [parishId], references: [id], onDelete: SetNull)
  documentRequests          DocumentRequest[]         @relation("DocumentRequestSubmitter")
  processedDocumentRequests DocumentRequest[]         @relation("DocumentRequestProcessor")
  schedules                 Schedule[]                @relation("ScheduleRequester")
  processedSchedules        Schedule[]                @relation("ScheduleProcessor")
  assignedSchedules         Schedule[]                @relation("SchedulePriestAssignment")
  requestedSchedules        Schedule[]                @relation("ScheduleRequestedPriest")
  availabilities            ParishAvailability[]
  notifications             Notification[]
  updatedFaqEntries         FaqKnowledgeBase[]        @relation("FaqUpdater")
  chatbotLogs               ChatbotLog[]
  activityLogs              ActivityLog[]
  requestHistory            RequestHistory[]          @relation("RequestHistoryActor")
  paymentTransactions       PaymentTransaction[]      @relation("PaymentTransactionVerifier")
  createdParishEvents       ParishEvent[]             @relation("ParishEventCreator")
  assignedParishEvents      ParishEvent[]             @relation("ParishEventPriest")
  massTemplates             MassScheduleTemplate[]    @relation("MassTemplatePriest")
  idempotencyKeys           IdempotencyKey[]
  createdScheduleDateRules  ParishScheduleDateRule[]  @relation("ScheduleDateRuleCreator")
  createdDailyReports       DailyReport[]             @relation("DailyReportCreator")
  archivedDailyReports      DailyReport[]             @relation("DailyReportArchiver")
  personalSchedules         PriestPersonalSchedule[]  @relation("PriestPersonalSchedules")
  scheduleHistoryActor      ScheduleHistory[]         @relation("ScheduleHistoryActor")
  approvedKnowledgeSources  KnowledgeSource[]         @relation("KnowledgeSourceApprovedBy")
  updatedKnowledgeSources   KnowledgeSource[]         @relation("KnowledgeSourceUpdatedBy")
  updatedCaloyConfigs       CaloyRuntimeConfig[]      @relation("CaloyRuntimeConfigUpdater")
  governmentIdVerification  GovernmentIdVerification?
  updatedLegalPolicies      LegalPolicy[]             @relation("LegalPolicyUpdater")
  submittedDocumentReturns  DocumentReturn[]          @relation("DocumentReturnSubmitter")
  correctedDocumentReturns  DocumentReturn[]          @relation("DocumentReturnCorrector")

  @@index([roleId])
  @@index([parishId])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model DocumentRequest {
  id                       Int                              @id @default(autoincrement()) @map("request_id")
  userId                   Int                              @map("user_id")
  parishId                 Int                              @map("parish_id")
  trackingNumber           String?                          @unique @map("tracking_number") @db.VarChar(50)
  applicantName            String                           @map("applicant_name") @db.VarChar(150)
  relationship             String?                          @db.VarChar(100)
  isDraft                  Boolean                          @default(true) @map("is_draft")
  documentType             DocumentType                     @map("document_type")
  purpose                  String?                          @db.Text
  status                   DocumentRequestStatus            @default(PENDING)
  paymentStatus            PaymentStatus                    @default(UNPAID) @map("payment_status")
  paymentProofObjectKey    String?                          @map("payment_proof_object_key") @db.VarChar(255)
  paymentQrReference       String?                          @map("payment_qr_reference") @db.VarChar(100)
  fee                      Decimal?                         @map("fee") @db.Decimal(10, 2)
  processedById            Int?                             @map("processed_by")
  remarks                  String?                          @db.Text
  correctionNote           String?                          @map("correction_note") @db.Text
  paymentCorrectionNote    String?                          @map("payment_correction_note") @db.Text
  correctionRequirementIds String[]                         @default([]) @map("correction_requirement_ids")
  dateRequested            DateTime                         @default(now()) @map("date_requested")
  dateProcessed            DateTime?                        @map("date_processed")
  createdAt                DateTime                         @default(now()) @map("created_at")
  updatedAt                DateTime                         @updatedAt @map("updated_at")
  user                     User                             @relation("DocumentRequestSubmitter", fields: [userId], references: [id], onDelete: Restrict)
  parish                   Parish                           @relation(fields: [parishId], references: [id], onDelete: Restrict)
  processedBy              User?                            @relation("DocumentRequestProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  attachments              RequestAttachment[]
  paymentTransactions      PaymentTransaction[]
  requestHistory           RequestHistory[]
  registrantIdEvidence     RegistrantIdEvidence?
  relationshipCorrections  RelationshipEvidenceCorrection[]
  returns                  DocumentReturn[]

  @@index([userId])
  @@index([parishId])
  @@index([processedById])
  @@index([documentType])
  @@index([status])
  @@index([paymentStatus])
  @@index([dateRequested])
  @@index([parishId, dateRequested])
  @@index([trackingNumber])
  @@map("document_requests")
}

model DocumentReturn {
  id                 Int             @id @default(autoincrement()) @map("return_id")
  requestId          Int             @map("request_id")
  cycleNumber        Int             @default(1) @map("cycle_number")
  reasonCode         String          @map("reason_code") @db.VarChar(50)
  notes              String?         @db.Text
  returnedObjectKey  String          @map("returned_object_key") @db.VarChar(255)
  returnedFileName   String          @map("returned_file_name") @db.VarChar(255)
  returnedFileType   String?         @map("returned_file_type") @db.VarChar(100)
  returnedFileSize   Int?            @map("returned_file_size")
  returnedAt         DateTime        @default(now()) @map("returned_at")
  returnedByUserId   Int             @map("returned_by_user_id")
  correctedObjectKey String?         @map("corrected_object_key") @db.VarChar(255)
  correctedFileName  String?         @map("corrected_file_name") @db.VarChar(255)
  correctedFileType  String?         @map("corrected_file_type") @db.VarChar(100)
  correctedFileSize  Int?            @map("corrected_file_size")
  correctedAt        DateTime?       @map("corrected_at")
  correctedByStaffId Int?            @map("corrected_by_staff_id")
  correctedRevision  Int             @default(0) @map("corrected_revision")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  request            DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  returnedByUser     User            @relation("DocumentReturnSubmitter", fields: [returnedByUserId], references: [id], onDelete: Restrict)
  correctedByStaff   User?           @relation("DocumentReturnCorrector", fields: [correctedByStaffId], references: [id], onDelete: SetNull)

  @@unique([requestId, cycleNumber])
  @@index([requestId, returnedAt])
  @@index([returnedByUserId])
  @@index([correctedByStaffId])
  @@map("document_returns")
}

model RegistrantIdEvidence {
  id                  Int                   @id @default(autoincrement()) @map("registrant_id_evidence_id")
  requestId           Int                   @unique @map("request_id")
  frontObjectKey      String?               @map("front_object_key") @db.VarChar(255)
  frontMimeType       String?               @map("front_mime_type") @db.VarChar(50)
  frontSize           Int?                  @map("front_size")
  frontSha256         String?               @map("front_sha256") @db.VarChar(64)
  frontUploadedAt     DateTime?             @map("front_uploaded_at")
  frontRevision       Int                   @default(0) @map("front_revision")
  backObjectKey       String?               @map("back_object_key") @db.VarChar(255)
  backMimeType        String?               @map("back_mime_type") @db.VarChar(50)
  backSize            Int?                  @map("back_size")
  backSha256          String?               @map("back_sha256") @db.VarChar(64)
  backUploadedAt      DateTime?             @map("back_uploaded_at")
  backRevision        Int                   @default(0) @map("back_revision")
  version             Int                   @default(0)
  ocrStatus           RegistrantIdOcrStatus @default(AWAITING_IMAGES) @map("ocr_status")
  ocrAttemptCount     Int                   @default(0) @map("ocr_attempt_count")
  ocrNextAttemptAt    DateTime?             @map("ocr_next_attempt_at")
  ocrProcessingToken  String?               @map("ocr_processing_token") @db.Uuid
  ocrProcessingAt     DateTime?             @map("ocr_processing_at")
  ocrLeaseExpiresAt   DateTime?             @map("ocr_lease_expires_at")
  ocrClaimedVersion   Int?                  @map("ocr_claimed_version")
  ocrClaimedFrontKey  String?               @map("ocr_claimed_front_key") @db.VarChar(255)
  ocrClaimedBackKey   String?               @map("ocr_claimed_back_key") @db.VarChar(255)
  ocrProcessedVersion Int?                  @map("ocr_processed_version")
  ocrProvider         String?               @map("ocr_provider") @db.VarChar(50)
  ocrErrorCode        String?               @map("ocr_error_code") @db.VarChar(80)
  extractedName       String?               @map("extracted_name") @db.VarChar(200)
  detectedIdType      String?               @map("detected_id_type") @db.VarChar(80)
  idNumber            String?               @map("id_number") @db.VarChar(120)
  dateOfBirth         DateTime?             @map("date_of_birth") @db.Date
  expiryDate          DateTime?             @map("expiry_date") @db.Date
  frontText           String?               @map("front_text") @db.Text
  backText            String?               @map("back_text") @db.Text
  advisoryFlags       String[]              @default([]) @map("advisory_flags")
  processedAt         DateTime?             @map("processed_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  request             DocumentRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([ocrStatus, ocrNextAttemptAt])
  @@index([ocrLeaseExpiresAt])
  @@map("registrant_id_evidence")
}

model RequestAttachment {
  id          Int             @id @default(autoincrement()) @map("attachment_id")
  requestId   Int             @map("request_id")
  fileName    String          @map("file_name") @db.VarChar(255)
  r2ObjectKey String          @map("r2_object_key") @db.VarChar(255)
  fileType    String?         @map("file_type") @db.VarChar(100)
  fileSize    Int?            @map("file_size")
  category    String          @db.VarChar(50) // "primary" | "supporting" | "receipt"
  uploadedAt  DateTime        @default(now()) @map("uploaded_at")
  request     DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_attachments")
}

model RelationshipEvidenceCorrection {
  id                       Int             @id @default(autoincrement()) @map("relationship_evidence_correction_id")
  requestId                Int             @map("request_id")
  requestedRequirementIds  String[]        @map("requested_requirement_ids")
  baselineFrontRevision    Int             @default(0) @map("baseline_front_revision")
  baselineBackRevision     Int             @default(0) @map("baseline_back_revision")
  baselineAuthAttachmentId Int?            @map("baseline_auth_attachment_id")
  requestedAt              DateTime        @default(now()) @map("requested_at")
  completedAt              DateTime?       @map("completed_at")
  request                  DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, requestedAt])
  @@map("relationship_evidence_corrections")
}

model PrivateObjectCleanupJob {
  id              Int                        @id @default(autoincrement()) @map("cleanup_job_id")
  objectKey       String                     @unique @map("object_key") @db.VarChar(255)
  status          PrivateObjectCleanupStatus @default(PENDING)
  reasonCode      String                     @map("reason_code") @db.VarChar(80)
  attemptCount    Int                        @default(0) @map("attempt_count")
  nextAttemptAt   DateTime                   @default(now()) @map("next_attempt_at")
  processingToken String?                    @map("processing_token") @db.Uuid
  processingAt    DateTime?                  @map("processing_at")
  leaseExpiresAt  DateTime?                  @map("lease_expires_at")
  lastErrorCode   String?                    @map("last_error_code") @db.VarChar(80)
  completedAt     DateTime?                  @map("completed_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
  @@map("private_object_cleanup_jobs")
}

model PaymentTransaction {
  id              Int                       @id @default(autoincrement()) @map("payment_id")
  requestId       Int                       @map("request_id")
  amount          Decimal?                  @db.Decimal(10, 2)
  provider        String?                   @db.VarChar(50)
  referenceNumber String?                   @map("reference_number") @db.VarChar(100)
  status          PaymentVerificationStatus @default(PENDING)
  verifiedById    Int?                      @map("verified_by")
  verifiedAt      DateTime?                 @map("verified_at")
  createdAt       DateTime                  @default(now()) @map("created_at")

  request  DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  verifier User?           @relation("PaymentTransactionVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  receipts ReceiptUpload[]

  @@index([requestId])
  @@index([verifiedById])
  @@index([status, createdAt])
  @@map("payment_transactions")
}

model ReceiptUpload {
  id                   Int      @id @default(autoincrement()) @map("receipt_id")
  paymentTransactionId Int      @map("payment_transaction_id")
  r2ObjectKey          String   @map("r2_object_key") @db.VarChar(255)
  fileName             String   @map("file_name") @db.VarChar(255)
  mimeType             String?  @map("mime_type") @db.VarChar(100)
  fileSize             Int?     @map("file_size")
  imageHash            String?  @map("image_hash") @db.VarChar(64)
  attemptVersion       Int      @default(1) @map("attempt_version")
  isSuperseded         Boolean  @default(false) @map("is_superseded")
  uploadedAt           DateTime @default(now()) @map("uploaded_at")

  transaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  ocrResult   OcrResult?

  @@unique([paymentTransactionId, attemptVersion])
  @@index([paymentTransactionId])
  @@index([imageHash])
  @@index([uploadedAt])
  @@map("receipt_uploads")
}

model OcrResult {
  id                 Int       @id @default(autoincrement()) @map("ocr_id")
  receiptUploadId    Int       @unique @map("receipt_upload_id")
  referenceNumber    String?   @map("reference_number") @db.VarChar(100)
  amount             String?   @db.VarChar(50)
  paymentDate        String?   @map("payment_date") @db.VarChar(100)
  provider           String?   @db.VarChar(50)
  confidenceScore    Float?    @map("confidence_score")
  rawText            String?   @map("raw_text") @db.Text
  processedAt        DateTime  @default(now()) @map("processed_at")
  status             OcrStatus @default(PENDING)
  // Expanded OCR metadata fields
  merchant           String?   @db.VarChar(100)
  paymentTime        String?   @map("payment_time") @db.VarChar(50)
  accountName        String?   @map("account_name") @db.VarChar(150)
  ocrProvider        String?   @map("ocr_provider") @db.VarChar(50)
  ocrDurationMs      Int?      @map("ocr_duration_ms")
  originalFileSize   Int?      @map("original_file_size")
  compressedFileSize Int?      @map("compressed_file_size")

  // Phase 2 additions
  ocrConfidence      Float?  @map("ocr_confidence")
  parserConfidence   Float?  @map("parser_confidence")
  finalConfidence    Float?  @map("final_confidence")
  ocrEngine          String? @map("ocr_engine") @db.VarChar(20)
  ocrLanguage        String? @map("ocr_language") @db.VarChar(20)
  compressionWidth   Int?    @map("compression_width")
  compressionQuality Int?    @map("compression_quality")
  normalizedAmount   String? @map("normalized_amount") @db.VarChar(50)
  normalizedDate     String? @map("normalized_date") @db.VarChar(30)

  // Fraud & Deduplication fields
  isDuplicate        Boolean @default(false) @map("is_duplicate")
  duplicateRequestId Int?    @map("duplicate_request_id")
