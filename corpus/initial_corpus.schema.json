{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://testimonium.sanctuary/schemas/initial_corpus.schema.json",
  "title": "TestimoniumKnowledgeCorpusSchema",
  "type": "object",
  "required": ["schemaVersion", "sources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "sourceText",
          "sourceType",
          "scope",
          "chunks"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "sourceText": {
            "type": "string",
            "minLength": 10,
            "maxLength": 20000
          },
          "category": {
            "type": "string",
            "maxLength": 100
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "SYSTEM_GUIDE",
              "PARISH_PROCEDURE",
              "DIOCESE_PROCEDURE",
              "CLERGY_INTERVIEW",
              "OFFICIAL_SOURCE",
              "LEGACY_FAQ",
              "ADMIN_ENTRY"
            ]
          },
          "sourceReference": {
            "type": "string",
            "maxLength": 500
          },
          "scope": {
            "type": "string",
            "enum": ["DIOCESE", "PARISH"]
          },
          "parishId": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "chunks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["content", "chunkOrder"],
              "additionalProperties": false,
              "properties": {
                "content": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 2000
                },
                "chunkOrder": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
